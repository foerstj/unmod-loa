[t:template,n:dsx_base_boot]
{
	doc = "DSX Boot base template";
	specializes = base_boot;
	[aspect]
	{
		[voice]
		{
			[put_down]
			{
				* = s_e_gui_put_down_boots;
			}
		}
	}
	[gui]
	{
		equip_slot = es_feet;
	}
}
[t:template,n:bo_bo_sc_f_g_c_avg_alloy_dsx]
{
	doc = "DSX Alloy Boots";
	specializes = dsx_base_boot;
	[common]
	{
	  b is_pcontent_allowed = false;
		screen_name = "Alloy Boots";
		pcontent_special_type = normal;
	}
	[defend]
	{
		armor_style = 500;
		armor_type = type1;
	  f defense = 9.000000;
	}
	[gui]
	{
		equip_requirements = strength:23;
		inventory_icon = b_gui_ig_i_a_boot_500;
		inventory_height = 2;
		inventory_width = 1;
	}
	[pcontent]
	{
		[base]
		{
		  f modifier_max = 9.000000;
		  f modifier_min = 0.000000;
		}
	}
}
